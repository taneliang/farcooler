<?xml version="1.0" encoding="utf-8"?>
<!--
    Nothing leaves this device.

    `allowBackup="false"` already covers the old backup path; this covers
    device-to-device transfer, which is the one that matters here. The SSH
    private key and the account's refresh token are encrypted with Keystore keys
    that cannot leave the hardware they were generated on, so a restored copy of
    the preferences would be ciphertext nothing can open — and a phone restored
    from another phone would authenticate as a device the machine never
    authorized, with no way to tell that from a rejected key.

    Making the exclusion explicit means a future preferences file cannot be
    swept along by a default that changed.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
    </device-transfer>
</data-extraction-rules>
