<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!--
        Required since Android 13 and asked for at launch rather than at the
        first notification: the point of the feature is being told about an
        agent while you are NOT looking at the app, and a prompt that only
        appears once you are has already missed it.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        For reading the code on a device being added, and asked for when the
        scan screen opens rather than at launch: the reason only makes sense
        while someone is holding two devices, and a camera prompt at first run
        is a prompt with nothing to explain it. `ScanScreen` states the why in
        the same breath as the request.
    -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!--
        Not required: a device with no camera can still be added by pasting its
        key, and `AuthorizeScreen` is that path. Declaring the feature as
        required would keep the app off such a device entirely.
    -->
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <application
        android:name=".FarCoolerApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.FarCooler">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|density|fontScale"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.FarCooler">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
                Where AuthKit sends the browser back to. `singleTask` above is
                what makes the redirect land on the activity that is already
                running rather than starting a second copy of the app on top of
                the terminal someone was reading.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <!-- Per channel, from `version.sh scheme` through
                     build.gradle.kts. Two installed apps claiming one scheme
                     is resolved by Android rather than by either of them, so a
                     canary and a stable sharing `farcooler://` can deliver a
                     sign-in to the wrong app — where the code fails, having
                     been issued against a different WorkOS environment. -->
                <data android:scheme="${authScheme}" android:host="auth" />
            </intent-filter>
        </activity>

        <!--
            Pushes from the relay, about an agent on a runner this phone is not
            watching. Not exported: only the messaging library binds to it.
        -->
        <service
            android:name=".notify.FarCoolerMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification" />

        <!--
            Which channel a push lands on when this process never sees it.

            The relay sends a `notification` message, so Firebase draws the tray
            notification itself whenever the app is backgrounded or dead — which
            is precisely the case the push exists for, and a case
            `FarCoolerMessagingService` is never called in. Without this the SDK
            creates a channel of its own, named "Miscellaneous", and the two
            channels this app describes and separates by importance are bypassed
            for every notification that matters most.

            Pointed at the FINISHED channel rather than the blocked one, and it
            is a choice rather than a default: today's push carries no status
            (see `NotificationCopy.channelFor`), so every one of them would take
            whichever this names. Under-alerting a blocked agent costs a
            notification that arrives quietly; over-alerting every finished one
            breaks a Focus for the normal case, and that is the failure people
            answer by turning the whole app off.

            The relay sending `android.notification.channel_id` per message
            overrides this, and is what makes the blocked channel reachable
            again.
        -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="@string/default_notification_channel_id" />
    </application>
</manifest>
