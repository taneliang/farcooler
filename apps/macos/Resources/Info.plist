<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleName</key>
	<string>Far Cooler</string>
	<key>CFBundleDisplayName</key>
	<string>Far Cooler</string>
	<key>CFBundleExecutable</key>
	<string>FarCooler</string>
	<key>CFBundleIdentifier</key>
	<string>com.farcooler.FarCooler</string>

	<!-- APPL plus a principal class is what makes this a real application
	     rather than a bare process. Without it macOS never grants a regular
	     activation policy, so the window can never become key and never
	     receives keystrokes. -->
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>

	<key>CFBundleShortVersionString</key>
	<string>0.1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleIconFile</key>
	<string>AppIcon</string>

	<key>LSMinimumSystemVersion</key>
	<string>26.0</string>

	<!-- Regular: appears in the Dock and the app switcher, owns a menu bar,
	     and can become the frontmost application. -->
	<key>LSUIElement</key>
	<false/>

	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSSupportsAutomaticTermination</key>
	<false/>
	<key>NSSupportsSuddenTermination</key>
	<false/>
    <!-- Shown in the system prompt the first time Far Cooler opens the camera,
         which is when somebody is adding a device. One line, saying what and
         why and naming nothing else: a prompt whose reason is vague is a prompt
         people deny, and a denied camera can only be undone in System Settings.

         Required to ask at all. Without this key the process is killed the
         moment it touches AVCaptureDevice, with a crash log and no prompt. -->
	<key>NSCameraUsageDescription</key>
	<string>Far Cooler uses the camera to scan the code on a device you're adding.</string>
    <!-- Where AuthKit comes back to. A custom scheme rather than a universal
         link because sign-in must work before an account exists and therefore
         before any server association could be verified; PKCE is what makes a
         scheme any app can claim safe to use — see AgentKit's Account. -->
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>com.farcooler.auth</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>farcooler</string>
            </array>
        </dict>
    </array>
    <!-- Public by design: it names the app to WorkOS, it is not a bearer. The
         API key lives only in the relay's secrets, which is what lets this repo
         be open source without shipping anything worth stealing. Blank here so
         a fork can point at its own WorkOS project without editing source. -->
    <!-- Which kind of build this is, stamped at build time from
         scripts/version.sh. The whole reason it exists: a beta and a release
         that call themselves the same version make a bug report unanswerable —
         someone says "0.2.0" and there is no way to know which one they had. -->
    <key>FarCoolerChannel</key>
    <string></string>
    <key>FarCoolerDisplayVersion</key>
    <string></string>
    <!-- This channel's login-agent launchd label, stamped by build-app.sh from
         the same AGENT_LABEL it uses to name the plist under
         Contents/Library/LaunchAgents. ServiceRegistration.swift reads it back
         rather than recomputing the suffix rule itself — one value, computed
         once, instead of a second expression of the same rule that could drift
         from it. Must exist here, even empty: build-app.sh's `stamp` helper
         fails the build if the key is missing rather than shipping a bundle
         that lies about itself. -->
    <key>FarCoolerAgentLabel</key>
    <string></string>
    <key>FarCoolerWorkOSClientID</key>
    <string></string>
    <!-- Sparkle. Stamped per channel by build-app.sh — see
         docs/superpowers/specs/2026-08-16-sparkle-auto-update-design.md.

         `SUFeedURL` is empty for local, and Updates.swift starts no updater
         without one: a local build is the working tree of whoever built it.

         `SUAutomaticallyUpdate` is false on every channel including canary.
         This is a tool people work inside, and an app that replaces itself
         unasked is a worse failure than an update noticed a day late. -->
    <key>SUFeedURL</key>
    <string></string>
    <key>SUPublicEDKey</key>
    <string></string>
    <key>SUEnableAutomaticChecks</key>
    <true/>
    <key>SUAutomaticallyUpdate</key>
    <false/>
    <key>SUScheduledCheckInterval</key>
    <integer>86400</integer>
</dict>
</plist>
