<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Without this the app is unsigned, has no entitlements at all, and every
         keychain write fails with errSecMissingEntitlement (-34018). The device
         then cannot hold an identity: each call generated a key, failed to store
         it, and generated another next time — so it authenticated with one key
         and displayed a different one to authorise, which looks exactly like a
         host rejecting a correct key. -->
    <key>keychain-access-groups</key>
    <array>
        <string>com.overnight.ios</string>
    </array>
</dict>
</plist>
