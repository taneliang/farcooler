<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Checked in rather than GENERATE_INFOPLIST_FILE, and UIAppFonts is the
         reason: INFOPLIST_KEY_<key> build settings only round-trip a flat
         string per key, and UIAppFonts is an array. Every other key here is
         one GENERATE_INFOPLIST_FILE was already synthesizing (see the
         Debug-iphonesimulator build's own Info.plist for the values this
         mirrors) — a real file loses nothing on those and gains the one
         thing an array needs: a place to write it down literally. -->
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>$(PRODUCT_NAME)</string>
    <key>CFBundleDisplayName</key>
    <string>Far Cooler</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <!-- Both deferred to build settings, which `generate-project.py` fills in
         from scripts/version.sh. The two apps and the daemon must report the
         same version — see that script for what goes wrong when they do not —
         and the only way to guarantee it is for neither plist to hold a
         literal. This one held "1.0" while the Mac held "0.1.0". -->
    <key>CFBundleShortVersionString</key>
    <string>$(MARKETING_VERSION)</string>
    <key>CFBundleVersion</key>
    <string>$(CURRENT_PROJECT_VERSION)</string>
    <key>LSRequiresIPhoneOS</key>
    <true/>
    <!-- Without this ActivityKit reports activities as disabled outright:
         `areActivitiesEnabled` is false, `Activity.request` throws, and no push
         can start one either. It is not a permission — the person still has a
         switch in Settings — it is the app declaring that it has a Live Activity
         at all, and the failure without it looks identical to a person having
         turned the feature off. -->
    <key>NSSupportsLiveActivities</key>
    <true/>
    <key>UILaunchScreen</key>
    <dict/>
    <key>UIApplicationSceneManifest</key>
    <dict>
        <key>UIApplicationSupportsMultipleScenes</key>
        <false/>
    </dict>
    <!-- Stated, because App Store Connect refuses a bundle that leaves it
         unsaid: "Invalid bundle. No orientations were specified" (90474), at
         UPLOAD — after a twenty-minute build, an archive and an export have all
         succeeded.

         Two keys because the answer differs by device. TARGETED_DEVICE_FAMILY
         is "1,2", and an iPad app has to accept all four or it cannot be a
         multitasking citizen — a terminal in a Split View beside a browser is
         a real way to use this. iPhone omits upside-down, which is the platform
         convention and what the OS does anyway on a device with a notch.

         A terminal has a strong opinion about width, but that belongs to the
         layout rather than to a refusal to rotate: a landscape phone is where
         someone reads a wide diff. -->
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
    <key>UISupportedInterfaceOrientations~ipad</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationPortraitUpsideDown</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
    <!-- The whole reason this file exists instead of a generated one. Each
         name is the .ttf's filename as bundled at the app's root — not its
         PostScript name, not its family name — which is what CoreText scans
         at launch to register the font before anything can ask for it by
         name. Get this filename wrong and the font silently fails to
         register: see FontRegistry.iosevkaIsRegistered in Settings.swift for
         the runtime check that exists because of exactly that failure mode. -->
    <key>UIAppFonts</key>
    <array>
        <string>IosevkaNerdFontMono-Regular.ttf</string>
        <string>IosevkaNerdFontMono-Bold.ttf</string>
    </array>
    <!-- Where AuthKit comes back to. A custom scheme rather than a universal
         link because sign-in must work before an account exists and therefore
         before any server association could be verified; PKCE is what makes a
         scheme any app can claim safe to use — see AgentKit's Account.

         Per channel, from `version.sh scheme`, because a scheme two installed
         apps both claim is decided by iOS rather than by either of them. With
         canary and stable on one phone, signing into canary could deliver the
         code to stable — where it fails, since it was issued against a
         different WorkOS environment. Stable keeps the bare `farcooler`, so
         nothing already registered has to change. -->
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>com.farcooler.auth</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>$(FARCOOLER_URL_SCHEME)</string>
            </array>
        </dict>
    </array>
    <!-- Public by design: it names the app to WorkOS, it is not a bearer. The
         API key lives only in the relay's secrets, which is what lets this repo
         be open source without shipping anything worth stealing. Blank here so
         a fork can point at its own WorkOS project without editing source. -->
    <!-- Which kind of build this is, stamped at build time from
         scripts/version.sh. The whole reason it exists: a beta and a release
         that call themselves the same version make a bug report unanswerable —
         someone says "0.2.0" and there is no way to know which one they had. -->
    <!-- Answered here so nobody has to answer it per build.
         Without this key every upload lands in App Store Connect as "Missing
         Compliance" and waits for a human to click through the export
         questionnaire before any tester can install it — which would make the
         canary channel, whose entire premise is that nobody presses anything,
         a channel where somebody presses something every time.

         `false` is the declaration that this app uses no NON-EXEMPT
         encryption. What it actually uses is standard, publicly available
         cryptography — TLS through the OS, and SSH through a Rust
         implementation of the published protocol — for authenticating to and
         reaching machines the person already owns. It implements no
         cryptography of its own and does not exist to encrypt data for the
         person using it.

         THIS IS A LEGAL DECLARATION, not a build setting. Revisit it if Far
         Cooler ever ships its own cipher, or ships encryption as a feature
         rather than as the means of reaching a host. -->
    <key>ITSAppUsesNonExemptEncryption</key>
    <false/>
    <key>FarCoolerChannel</key>
    <string>$(FARCOOLER_CHANNEL)</string>
    <key>FarCoolerDisplayVersion</key>
    <string>$(FARCOOLER_DISPLAY_VERSION)</string>
    <key>FarCoolerWorkOSClientID</key>
    <string>$(FARCOOLER_WORKOS_CLIENT_ID)</string>
</dict>
</plist>
