        { "terminal": "d-old", "runner": "studio", "status": "done", "sinceS": 900, "heardS": 5, "rank": 199999099 },
        { "terminal": "b-new", "runner": "studio", "status": "blocked", "sinceS": 60, "heardS": 5, "rank": 99999939 },
        { "terminal": "b-old", "runner": "studio", "status": "blocked", "sinceS": 600, "heardS": 5, "rank": 99999399 },
        { "terminal": "idle", "runner": "studio", "status": "idle", "sinceS": 5000, "heardS": 5, "rank": 399994999 },
        { "terminal": "w-twin", "runner": "studio", "status": "working", "sinceS": 300, "heardS": 5, "rank": 299999699 },
        { "terminal": "w-old", "runner": "studio", "status": "working", "sinceS": 300, "heardS": 5, "rank": 299999699 }
