{
  "name": "farcooler-web",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "./build.sh",
    "dev": "wrangler dev",
    "test": "vitest run && npm run test:needs",
    "pretest:needs": "cargo build --manifest-path ../../Cargo.toml -p farcooler-client --example plan_view_bin -j 2",
    "test:needs": "vitest run --config vitest.needs.config.ts",
