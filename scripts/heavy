#!/usr/bin/env python3
"""Run one heavy command under the machine-wide lock (ov-836).

    scripts/heavy -- cargo nextest run --profile ci --workspace
    scripts/heavy --no-lock -- swift test        # lock and load wait off
    scripts/heavy --light -- cargo test -p X name  # short filtered run: no queue, 2 at a time (ov-843)

Waits for the 5-minute load average to fall under 20, takes the same flock
scripts/lane-gate.py takes (scripts/heavy_lock.py), writes the holder note
(worktree, PID, start time, command), runs the command, passes its exit status
through, and releases. A wait prints who holds the lock. Off under CI.
In a lane worktree a cargo command also builds without debug info and keeps target/ under 20 GB, which
keeps the disk from filling (ov-837, scripts/heavy_lock.py); FARCOOLER_LEAN_BUILD=off opts out.
Use it for builds and test suites: cargo, swift test, gradle, xcodebuild, apps/macos/test.sh.
"""
import argparse
import os
import shlex
import signal
import subprocess
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import heavy_lock as hl  # noqa: E402


def main(argv):
    ap = argparse.ArgumentParser(description="Run a heavy command under the machine-wide lock.", usage="scripts/heavy [--no-lock] [--light] [--load-limit N] -- command ...")
    ap.add_argument("--no-lock", action="store_true", help="skip the lock and the load wait (they are off already when CI is set)")
    ap.add_argument("--light", action="store_true", help="a short filtered run (cargo test -p X name, vitest run file, swift test --filter): skip the gate queue, take one of 2 light slots while the load is under the limit; refused for anything else")
    ap.add_argument("--load-limit", type=float, default=float(os.environ.get("HEAVY_LOAD_LIMIT", hl.LOAD_LIMIT)), help="5-minute load average to wait under (default 20)")
    ap.add_argument("command", nargs=argparse.REMAINDER)
    args = ap.parse_args(argv)
    hl.survive_dead_output()
    cmd = args.command[1:] if args.command[:1] == ["--"] else args.command
    if not cmd:
        ap.error("no command; usage: scripts/heavy -- <command...>")
    top = subprocess.run(["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True).stdout.strip() or os.getcwd()
    if args.light:
        why = hl.light_refusal(cmd, top)
        if why:
            print(f"scripts/heavy --light: {why}. Run it without --light to queue.", file=sys.stderr)
            return 2
    if not hl.lock_wanted(args.no_lock) or os.environ.get(hl.HELD_ENV):
        return run(cmd)
    poll = float(os.environ.get("HEAVY_POLL", hl.LOCK_POLL))
    announce = float(os.environ.get("HEAVY_ANNOUNCE", 60))
    if args.light:  # no place in the gate queue; the load wait above and a light slot are the whole gate (ov-843)
        with hl.light_slot(shlex.join(cmd), slots=None, limit=args.load_limit, poll=poll, announce=announce, say=lambda m, **k: print(m, file=sys.stderr, **k)):
            return run(cmd, held=True, extra=hl.lean_cargo_env(top) if hl.runs_cargo(cmd) else {})
    hl.wait_for_load(args.load_limit, load=hl.load5,
                     say=lambda m, **k: print(m.replace("load average", "5-minute load average"), file=sys.stderr, **k))
    with hl.machine_lock(top, shlex.join(cmd), poll=poll, announce=announce, say=lambda m, **k: print(m, file=sys.stderr, **k)):
        extra = hl.prepare_lane_build(top, say=lambda m, **k: print(m, file=sys.stderr, **k)) if hl.runs_cargo(cmd) else {}
        return run(cmd, held=True, extra=extra)


def run(cmd, held=False, extra=None):
    try:
        child = subprocess.Popen(cmd, env={**os.environ, hl.HELD_ENV: "1", **(extra or {})} if held else None)
    except OSError as e:
        print(f"scripts/heavy: cannot run {cmd[0]}: {e.strerror}", file=sys.stderr)
        return 127
    for sig in (signal.SIGTERM, signal.SIGHUP):
        signal.signal(sig, lambda n, _f: child.send_signal(n))
    while True:
        try:
            rc = child.wait()
            break
        except KeyboardInterrupt:
            pass  # Ctrl-C reached the child too; wait for it to finish
    return 128 - rc if rc < 0 else rc


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
