#!/usr/bin/env python3
"""Run one heavy command under the machine-wide lock (ov-836).

    scripts/heavy -- cargo nextest run --profile ci --workspace
    scripts/heavy --no-lock -- swift test        # lock and load wait off

Waits for the 5-minute load average to fall under 20, takes the same flock
scripts/lane-gate.py takes (scripts/heavy_lock.py), writes the holder note
(worktree, PID, start time, command), runs the command, passes its exit status
through, and releases. A wait prints who holds the lock. Off under CI.
Use it for builds and test suites: cargo, swift test, gradle, xcodebuild, apps/macos/test.sh.
"""
import argparse
import os
import shlex
import signal
import subprocess
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import heavy_lock as hl  # noqa: E402


def main(argv):
    ap = argparse.ArgumentParser(description="Run a heavy command under the machine-wide lock.", usage="scripts/heavy [--no-lock] [--load-limit N] -- command ...")
    ap.add_argument("--no-lock", action="store_true", help="skip the lock and the load wait (they are off already when CI is set)")
    ap.add_argument("--load-limit", type=float, default=float(os.environ.get("HEAVY_LOAD_LIMIT", hl.LOAD_LIMIT)), help="5-minute load average to wait under (default 20)")
    ap.add_argument("command", nargs=argparse.REMAINDER)
    args = ap.parse_args(argv)
    cmd = args.command[1:] if args.command[:1] == ["--"] else args.command
    if not cmd:
        ap.error("no command; usage: scripts/heavy -- <command...>")
    if not hl.lock_wanted(args.no_lock):
        return run(cmd)
    poll = float(os.environ.get("HEAVY_POLL", hl.LOCK_POLL))
    announce = float(os.environ.get("HEAVY_ANNOUNCE", 60))
    hl.wait_for_load(args.load_limit, load=hl.load5,
                     say=lambda m, **k: print(m.replace("load average", "5-minute load average"), file=sys.stderr, **k))
    top = subprocess.run(["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True).stdout.strip() or os.getcwd()
    with hl.machine_lock(top, shlex.join(cmd), poll=poll, announce=announce, say=lambda m, **k: print(m, file=sys.stderr, **k)):
        return run(cmd)


def run(cmd):
    try:
        child = subprocess.Popen(cmd)
    except OSError as e:
        print(f"scripts/heavy: cannot run {cmd[0]}: {e.strerror}", file=sys.stderr)
        return 127
    for sig in (signal.SIGTERM, signal.SIGHUP):
        signal.signal(sig, lambda n, _f: child.send_signal(n))
    while True:
        try:
            rc = child.wait()
            break
        except KeyboardInterrupt:
            pass  # Ctrl-C reached the child too; wait for it to finish
    return 128 - rc if rc < 0 else rc


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
