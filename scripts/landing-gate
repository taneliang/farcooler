#!/usr/bin/env bash
# Local landing gate: quick checks first, then parallel affected families.
# scripts/lane-gate.py reads checks from CI and uses the engine's pinned fold
# base. Build jobs wait for load and take the machine lock. CI on main retains
# full Rust suites and release bundle checks.
set -u
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
gate=("$here/lane-gate.py" --fail-fast --landing --keep-target --wait-for-unlock)
for a in "$@"; do
  case "$a" in --dry-run|--quick-only|--self-test|-h|--help) exec python3 "${gate[@]}" "$@" ;; esac
done

python3 "${gate[@]}" "$@"
rc=$?
if [ "$rc" -eq 0 ]; then echo "landing-gate: PASS"; else echo "landing-gate: FAIL (exit $rc)"; fi
exit "$rc"
