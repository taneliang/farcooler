/target
**/*.rs.bk
.DS_Store
apps/macos/.build
apps/macos/build

# Staged by apps/macos/build-vt.sh from crates/vt/include, which is the single
# source of truth for the ABI. Committing a copy would let the two drift.
apps/macos/Sources/CFarCoolerVT/farcooler_vt.h

# Built by scripts/build-ios-frameworks.sh from crates/*/include and the Rust
# static libraries. Generated, not source.
apps/ios/Frameworks/
apps/ios/build/
dist/
apps/shared/AgentKit/.build/

# Built by scripts/build-android-libs.sh from the Rust workspace. Generated, not
# source — and large: a debug-symbol-laden `.so` per ABI is tens of megabytes.
apps/android/app/src/main/jniLibs/

# Per-project Firebase configuration. It names a real Firebase project and is
# not something a checkout should inherit; without it the app builds and runs
# with local notifications only. See apps/android/README.md.
apps/android/app/google-services.json

# Staged by apps/android/app/build.gradle.kts from apps/ios/FarCooler/Fonts,
# which is the single copy of these files. Committing a second one would add
# 26 MB to history and let the two apps drift on to different font builds.
apps/android/app/src/main/res/font/

apps/android/.gradle/
apps/android/build/
apps/android/app/build/
apps/android/local.properties
